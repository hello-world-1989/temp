[Unit]
Description=end-gfw 加密聊天 (chat)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/end-gfw-chat/chat-server/src/server.js
WorkingDirectory=/opt/end-gfw-chat/chat-server
User=end-gfw-chat
Group=end-gfw-chat
# TLS from the mirrors' port 8443 (TCP relay); plain HTTP from their port 80 for ACME and
# check-ins; local HTTP for health checks. See src/config.js.
Environment=LISTEN_TLS=0.0.0.0:8443
Environment=LISTEN_ACME=0.0.0.0:8080
Environment=LISTEN_HTTP=127.0.0.1:8792
Environment=DATA_DIR=/var/lib/end-gfw-chat
Environment=ACME_SH=/opt/end-gfw-chat/acme.sh
Environment=HOME=/var/lib/end-gfw-chat
# Optional overrides (ALLOW_FROM=mirror IPs, limits): /etc/end-gfw-chat/env
EnvironmentFile=-/etc/end-gfw-chat/env
# 事件墙's admin token hashes: who may review the public room list
LoadCredential=admins:/etc/end-gfw-chat/admins
# Messages, room hashes and the mirrors' TLS keys. Not backed up on purpose: deleted means gone.
StateDirectory=end-gfw-chat
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
MemoryMax=384M
LimitNOFILE=65536
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
