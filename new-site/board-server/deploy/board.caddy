# end-gfw 事件墙 API, reached only through the Cloudflare Tunnel end-gfw-board
# (board-store.end-gfw.com -> cloudflared -> 127.0.0.1:8081). No public port, no certificate:
# TLS ends at Cloudflare and the tunnel is an outbound encrypted connection.
# Only /api/board/* is served; Caddy keeps no access log (no `log` directive).
http://:8081 {
	bind 127.0.0.1
	request_body {
		max_size 10MB
	}
	handle /api/board/* {
		reverse_proxy 127.0.0.1:8791
	}
	handle {
		respond 404
	}
}
