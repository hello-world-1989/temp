[Unit]
Description=end-gfw 事件墙 (board) API
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
ExecStart=/usr/bin/node /opt/end-gfw-board/board-server/src/server.js
WorkingDirectory=/opt/end-gfw-board/board-server
# Unix socket + peer auth: the system user end-gfw-board is also the database role, no password
User=end-gfw-board
Group=end-gfw-board
Environment=PGHOST=/var/run/postgresql
Environment=PGDATABASE=end_gfw_board
Environment=PGUSER=end-gfw-board
Environment=LISTEN=127.0.0.1:8791
Environment=FILES_DIR=/var/lib/end-gfw-board/files
EnvironmentFile=-/etc/end-gfw-board/env
LoadCredential=board-key:/etc/end-gfw-board/board-key
LoadCredential=admins:/etc/end-gfw-board/admins
StateDirectory=end-gfw-board
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
MemoryMax=320M
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
