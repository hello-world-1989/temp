# end-gfw 加密分享 storage: Caddy in front of store.py, reached only through the Cloudflare
# Tunnel end-gfw-share (share-store.end-gfw.com -> cloudflared -> 127.0.0.1:8081).
# No public port, no certificate. Only /f/<id> is served; no access log.
{
	admin off
	auto_https off
}

http://:8081 {
	bind 127.0.0.1
	request_body {
		# 50 MiB file + encryption overhead (MB here would be decimal: 52MB < 50 MiB)
		max_size 64MiB
	}
	@file path_regexp ^/f/[A-Za-z0-9_-]{22}$
	handle @file {
		reverse_proxy 127.0.0.1:8790 {
			flush_interval -1
		}
	}
	handle {
		respond 404
	}
}
