# end-gfw 加密分享 storage: TLS in front of store.py. Only /f/<id> is served; no access log.
{
	admin off
}

# The Worker cannot use a hostname in its own Cloudflare zone (such subrequests go to the
# origin over plain HTTP), so it uses these IP-based names, which resolve to this server
# without Cloudflare. share-store.end-gfw.com is kept for direct checks.
share-store.end-gfw.com, 43-200-196-209.sslip.io, 43-200-196-209.nip.io {
	request_body {
		# 50 MiB file + encryption overhead (MB here would be decimal: 52MB < 50 MiB)
		max_size 64MiB
	}
	@file path_regexp ^/f/[A-Za-z0-9_-]{22}$
	handle @file {
		reverse_proxy 127.0.0.1:8790 {
			flush_interval -1
		}
	}
	handle {
		respond 404
	}
}
